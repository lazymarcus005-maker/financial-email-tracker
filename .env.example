# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real credentials.

# --- Database -----------------------------------------------------------
# Backend: "aiosqlite" (default, local file) or "postgres" (PostgreSQL server -
# the target for multi-machine access / more concurrent load).
DATABASE_BACKEND=aiosqlite
DATABASE_PATH=data/finance.db

# --- postgres (DATABASE_BACKEND=postgres) ----------------------------------
# DATABASE_URL is the postgres DSN: postgresql://user:pass@host:5432/dbname
# If the password contains special characters (#, @, :, /, %), percent-encode
# them (e.g. # -> %23) - many env-var loaders and .env parsers treat a raw
# unescaped `#` as a comment marker and silently truncate everything after it,
# which breaks the connection with a confusing "invalid literal for int()"
# error at startup. The app decodes the percent-encoding automatically.
DATABASE_URL=
# DATABASE_SSL defaults to true - only set false against an endpoint you KNOW
# has no TLS and have explicitly accepted the risk for (dev/test only). Never
# send real financial data over an unencrypted connection across the internet.
DATABASE_SSL=true

# --- Gmail (OAuth2, readonly) --------------------------------------------
# OAuth "Web application" client from Google Cloud Console. Add
# /gmail/oauth2/callback as an authorized redirect URI. Only client_id and
# client_secret are needed - no credentials.json file on disk.
GMAIL_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Per-user Gmail tokens are created at runtime under
# secrets/users/{user_id}/gmail-token.json when a user connects Gmail in
# Settings. Keep secrets/ on a persistent volume so tokens survive redeploys.

# --- LINE Messaging API ---------------------------------------------------
# Channel access token from the LINE Developers console (Messaging API channel).
LINE_CHANNEL_ACCESS_TOKEN=xxx
# Your LINE user id (LINE Login "Basic ID" -> use the userId from a webhook
# event, or the "Your user ID" field in the LINE Developers console).
LINE_USER_ID=xxx

# --- AI-assisted categorization (optional) --------------------------------
AI_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:7b-plus

# --- General ---------------------------------------------------------------
TIMEZONE=Asia/Bangkok
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Web authentication ----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=change-me
# Public URL used for OAuth redirects behind a reverse proxy.
# Example: PUBLIC_BASE_URL=https://kplus.mxlabs.cloud
PUBLIC_BASE_URL=https://kplus.mxlabs.cloud

# --- MCP (Model Context Protocol) server ------------------------------------
# Local stdio MCP server for AI agents (Claude Desktop, Cursor, etc). Disabled
# by default - see docs/mcp-agent-config.md for setup and security notes.
MCP_ENABLED=false
# User id the MCP server acts as (local stdio mode is single-user). Required
# to run `python -m app.mcp.server`.
MCP_OWNER_USER_ID=
# Allow write tools (update category, ignore transaction, create mapping,
# run ingestion). Read-only tools work regardless of this flag.
MCP_ALLOW_WRITE=false
# Allow the send_line_daily_summary tool to push a real LINE message. Kept
# separate from MCP_ALLOW_WRITE since it has an external, user-visible effect.
MCP_ALLOW_SEND=false
# Allow read tools to include parsed raw_fields (masked) in their output.
MCP_EXPOSE_RAW_EMAIL=false
# Reserved for a future remote/HTTP MCP transport (Phase 3) - unused by the
# local stdio server.
MCP_API_TOKEN=
