# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real credentials.

# --- Database -----------------------------------------------------------
DATABASE_PATH=data/finance.db

# --- Gmail (OAuth2, readonly) --------------------------------------------
# Download credentials.json from Google Cloud Console (OAuth client, Desktop app)
# and place it at this path. token.json is created automatically after the
# first interactive `python -m app.gmail.authorize` login.
GMAIL_CREDENTIALS_PATH=secrets/credentials.json
GMAIL_TOKEN_PATH=secrets/token.json

# --- LINE Messaging API ---------------------------------------------------
# Channel access token from the LINE Developers console (Messaging API channel).
LINE_CHANNEL_ACCESS_TOKEN=xxx
# Your LINE user id (LINE Login "Basic ID" -> use the userId from a webhook
# event, or the "Your user ID" field in the LINE Developers console).
LINE_USER_ID=xxx

# --- AI-assisted categorization (optional) --------------------------------
AI_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:7b-plus

# --- General ---------------------------------------------------------------
TIMEZONE=Asia/Bangkok
LOG_LEVEL=INFO
LOG_FORMAT=json
